<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.openplantpulse.hub</string>

    <!-- Runs the app bundle rather than python directly, so macOS can
         attribute Bluetooth permission to a stable code identity. -->
    <key>ProgramArguments</key>
    <array>
        <string>@APP_DIR@/Contents/MacOS/hub</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>@LOG_DIR@/hub.out.log</string>
    <key>StandardErrorPath</key>
    <string>@LOG_DIR@/hub.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>

    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>com.openplantpulse.hub</string>
    </array>
</dict>
</plist>
