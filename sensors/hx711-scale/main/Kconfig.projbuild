menu "HX711 scale"

    choice SCALE_LINK
        prompt "How the scale talks to other devices"
        default SCALE_LINK_WIFI

        config SCALE_LINK_WIFI
            bool "Wi-Fi: web page and over-the-air updates"
        config SCALE_LINK_BLE
            bool "Bluetooth LE: Chrome page on the Mac (mac/scale.html)"
        config SCALE_LINK_USB
            bool "USB only, no radio: Chrome page on the Mac (mac/scale.html)"
    endchoice

    config SCALE_ZIGBEE
        bool "Also speak Zigbee, alongside Wi-Fi"
        depends on SCALE_LINK_WIFI
        default n
        help
            Joins a Zigbee coordinator and sends every reading to it, while
            keeping Wi-Fi up so the scale stays reachable for over-the-air
            updates. The two share one radio and take turns.

    config SCALE_ZIGBEE_MIN_GAP_SECONDS
        int "Floor on the gap between Zigbee reports, in seconds"
        depends on SCALE_ZIGBEE
        range 1 3600
        default 30
        help
            Zigbee reports at whatever the sampling interval is set to, so
            there is one rate to configure and it can be changed at runtime
            with "i <seconds>".

            This is only a guard for continuous mode, where the scale samples
            ten times a second for a live display: relaying all of that keeps
            the shared radio busy enough to push Wi-Fi off the air.

    config SCALE_ZIGBEE_CHANNEL
        int "Zigbee channel to look for the coordinator on"
        depends on SCALE_ZIGBEE
        range 0 26
        default 15
        help
            Must match the channel the coordinator formed its network on.
            Searching every channel instead keeps the shared radio busy long
            enough to stop Wi-Fi associating.

    config SCALE_HOME_WIFI_SSID
        string "Home Wi-Fi name to join on a first boot"
        default ""
        help
            Only a bootstrap. The Wi-Fi driver keeps whatever it last joined
            in NVS, and the scale uses that in preference, so this is read on
            a device that has never joined anything -- after a full erase, or
            the first time a board is flashed.

            Leave it empty and the scale starts its own network instead,
            HX711-Scale at 192.168.4.1, where POST /api/wifi can give it the
            household's. Set it in sdkconfig, which git ignores, and never in
            a source file: this repository is public.

    config SCALE_HOME_WIFI_PASS
        string "Password for that network"
        default ""

endmenu
