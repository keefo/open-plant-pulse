CONFIG_IDF_TARGET="esp32c3"
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# Bonds live in RAM unless this is set, so a deep-sleep wake would lose the hub
# and the sensor would fall back to onboarding at every reporting interval.
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# One sensor belongs to one hub. Moving a sensor requires a reset, not a second bond.
CONFIG_BT_NIMBLE_MAX_BONDS=1
CONFIG_BT_BLUEDROID_ENABLED=n
# The XIAO ESP32-C3 has always had 4 MB; the image header said 2 MB, which left
# no room for a second application slot.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# A new image boots as pending and must say it works. One that crashes before
# it can is replaced by the previous one at the next reset, with no help.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y