CONFIG_IDF_TARGET="esp32c6"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The radio is on this chip, and the stack runs here: no co-processor.
CONFIG_ZB_ENABLED=y
CONFIG_ZB_ZCZR=y

CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_FREERTOS_HZ=1000

# Console on the UART bridge: the same cable that flashes the board also
# carries the log. The native USB port drops out when the board is reset
# over the bridge, which leaves a dead /dev node behind.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
